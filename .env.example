# Optional environment overrides for controller_validation_task.
# These OVERRIDE values in config.json but are OVERRIDDEN by CLI flags.
# Most users should configure via the first-run wizard (auto-launched on the
# first `bash run.sh`) and leave this file alone.
#
# Precedence:  defaults  <  config.json  <  .env / environment  <  CLI flags

# --- Paths -----------------------------------------------------------------
# CVT_OUTPUT_ROOT=output
# CVT_ASSETS_DIR=/path/to/your/assets     # custom controller image + layout
# CVT_LAYOUT_FILE=/path/to/layout.json    # custom controller geometry only

# --- Design ----------------------------------------------------------------
# CVT_N_RUNS=2
# CVT_LR_MODE=0            # 1 = left/right hand mode (dims half the pad)
# CVT_TR=1.49              # ISIs default to [TR, 2*TR]; block gap to 2*TR
# CVT_SEED=                # blank = derive from sha1(subject_session_run)

# --- Controller keys -------------------------------------------------------
# The pad is read as a keyboard. Which keys it sends depends on your hardware,
# so the mapping lives in config.json under "input": { "key_map": {...} }.
# The default accepts BOTH arrow keys (left/right/up/down) and the AntiMicroX
# letter profile (l/r/u/d), plus a/b/x/y — so most controllers work as-is.

# --- Scanner start signal (sync) -------------------------------------------
# mode:    none (start immediately, the default) | wait | send
# backend: defaults to 'none' -- no hardware, so 'wait' listens on the keyboard
#          send -> none | serial | parallel | lsl | key | markers
#          wait -> none | keyboard | serial
# CVT_SYNC_MODE=send
# CVT_SYNC_BACKEND=serial
# CVT_SYNC_PORT=/dev/ttyUSB0     # Linux;  COM3 on Windows
# CVT_SYNC_SIGNAL=s              # what to send, or wait for; comma-separated for
#                               # alternatives, e.g. 5,percent

# --- Outgoing event markers (MEG / EEG) ------------------------------------
# CVT_TRIGGER_BACKEND=lsl        # lsl | serial | parallel | null
# CVT_TRIGGER_PORT=/dev/ttyACM0  # serial;  /dev/parport1 for parallel

# LSL stream metadata (only used when the trigger backend is lsl)
# LSL_STREAM_NAME=controller_validation
# LSL_STREAM_TYPE=Markers
# LSL_STREAM_SOURCE_ID=controller_validation_markers

# --- Display (mostly for debugging on a single-monitor dev box) ------------
# EXP_WIN_FULLSCR=0
# EXP_WIN_SCREEN=0
# EXP_WIN_W=1280
# EXP_WIN_H=720
